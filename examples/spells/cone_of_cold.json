{
  "name": "Cone of Cold",
  "description": "A blast of cold air erupts from your hands. Each creature in a 60-foot cone must make a Constitution saving throw. A creature takes 8d8 cold damage on a failed save, or half as much damage on a successful one.",
  "type": "spell",
  "spell_level": 5,
  "cannot_cause_self_damage": true,
  "spell_range": {
    "type": "feet",
    "distance_ft": 60
  },
  "targeting_type": "aoe",
  "aoe": {
    "shape": "cone",
    "size_ft": 60
  },
  "casting_time": {
    "type": "action",
    "count": 1
  },
  "duration": {
    "unit": "instantaneous"
  },
  "components": {
    "verbal": true,
    "somatic": true,
    "material": ["a small crystal or glass cone"]
  },
  "higher_level_scaling": "When you cast this spell using a spell slot of 6th level or higher, the damage increases by 1d8 for each slot level above 5th.",
  "effects": [
    {
      "type": "saving_throw",
      "attribute": "constitution",
      "dc": "use_caster_dc",
      "target": "for_each_defender"
    },
    {
      "type": "damage",
      "target": "for_each_defender",
      "damage_type": "COLD",
      "formula": "8d8",
      "roll_once": true,
      "save_result": {"on_success": "half_damage"}
    }
  ],
  "animation": [
    [
      {
        "type": "expanding_cone",
        "color": "#aaeeff",
        "from": "caster",
        "to": "target_point",
        "distance_ft": 60,
        "speed": 10,
        "fill": true,
        "opacity": 0.35
      },
      {
        "type": "particles",
        "color": "#cceeff",
        "at": "caster",
        "count": 30,
        "spread": 60,
        "duration": 0.5,
        "speed": 3.0
      }
    ],
    [
      {"type": "flash", "color": "#aaeeff", "at": "each_target", "duration": 0.35},
      {"type": "particles", "color": "#ffffff", "at": "each_target", "count": 10, "spread": 5, "duration": 0.4, "speed": 1.5}
    ]
  ]
}
