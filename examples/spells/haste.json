{
  "name": "Haste",
  "description": "Choose a willing creature that you can see within range. Until the spell ends, the target's speed is doubled, it gains a +2 bonus to AC, it has advantage on Dexterity saving throws, and it gains an additional action on each of its turns.",
  "type": "spell",
  "spell_level": 3,
  "spell_range": {
    "type": "feet",
    "distance_ft": 30
  },
  "can_target_self": true,
  "targeting_type": "single_target",
  "casting_time": {
    "type": "action",
    "count": 1
  },
  "duration": {
    "unit": "minute",
    "count": 1,
    "concentration": true
  },
  "components": {
    "verbal": true,
    "somatic": true,
    "material": ["a shaving of licorice root"]
  },
  "program": [
    {
      "block": "lifetime",
      "kind": "concentration",
      "source": "haste",
      "duration_rounds": 10,
      "then": [
        {
          "block": "trigger",
          "event": "TURN_START",
          "holder": "defender",
          "when": "event.entity == entity",
          "then": [
            {
              "block": "add_resource",
              "target": "defender",
              "resource": "actions",
              "amount": 1
            }
          ]
        }
      ]
    }
  ],
  "animation": [
    [{"type": "projectile", "color": "#FFDD44", "from": "caster", "to": "target", "speed": 6, "size": 2, "trail": false}],
    [{"type": "aura", "color": "#FFDD44", "at": "target", "duration": 1.0, "size": 1.5, "pulses": 3}]
  ]
}
