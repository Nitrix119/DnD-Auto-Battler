{
  "name": "Burning Hands",
  "description": "As you hold your hands with thumbs touching and fingers spread, a thin sheet of flames shoots forth from your outstretched fingertips. Each creature in a 15-foot cone must make a Dexterity saving throw. A creature takes 3d6 fire damage on a failed save, or half as much damage on a successful one.",
  "type": "spell",
  "spell_level": 1,
  "spell_range": {
    "type": "self"
  },
  "targeting_type": "aoe",
  "aoe": {
    "shape": "cone",
    "size_ft": 15
  },
  "casting_time": {
    "type": "action",
    "count": 1
  },
  "duration": {
    "unit": "instantaneous"
  },
  "components": {
    "verbal": true,
    "somatic": true,
    "material": []
  },
  "higher_level_scaling": "When you cast this spell using a spell slot of 2nd level or higher, the damage increases by 1d6 for each slot level above 1st.",
  "program": [
    {
      "block": "for_each_target",
      "then": [
        {
          "block": "saving_throw",
          "attribute": "dexterity",
          "dc": "use_caster_dc"
        },
        {
          "block": "damage",
          "damage_type": "FIRE",
          "formula": "3d6",
          "roll_once": true,
          "save_result": {"on_success": "half_damage"}
        }
      ]
    }
  ],
  "animation": [
    [{"type": "expanding_ring", "color": "#FF6600", "at": "caster", "radius": 15, "speed": 8, "fill": true}],
    [
      {"type": "flash", "color": "#FF4400", "at": "each_target", "duration": 0.3},
      {"type": "particles", "color": "#FF2200", "at": "caster", "count": 20, "spread": 15, "duration": 0.5, "speed": 2.5}
    ]
  ]
}
