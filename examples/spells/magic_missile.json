{
  "name": "Magic Missile",
  "description": "You create three glowing darts of magical force. Each dart hits a creature of your choice that you can see within range. A dart deals 1d4 + 1 force damage to its target. The darts all strike simultaneously.",
  "type": "spell",
  "spell_level": 1,
  "spell_range": {
    "type": "feet",
    "distance_ft": 120
  },
  "targeting_type": "multi_target",
  "casting_time": {
    "type": "action",
    "count": 1
  },
  "duration": {
    "unit": "instantaneous"
  },
  "components": {
    "verbal": true,
    "somatic": true,
    "material": []
  },
  "higher_level_scaling": "When you cast this spell using a spell slot of 2nd level or higher, the spell creates one more dart for each slot level above 1st.",
  "program": [
    {
      "block": "for_each_target",
      "then": [
        {
          "block": "damage",
          "target": "defender",
          "damage_type": "FORCE",
          "formula": "1d4+1"
        }
      ]
    }
  ],
  "animation": [
    [
      {"type": "projectile", "color": "#9999FF", "from": "caster", "to": "target", "speed": 10, "size": 2, "trail": true},
      {"type": "projectile", "color": "#AAAAFF", "from": "caster", "to": "target", "speed": 8, "size": 2, "trail": true},
      {"type": "projectile", "color": "#BBBBFF", "from": "caster", "to": "target", "speed": 6, "size": 2, "trail": true}
    ],
    [{"type": "flash", "color": "#AAAAFF", "at": "target", "duration": 0.3, "size": 1.2}]
  ]
}
