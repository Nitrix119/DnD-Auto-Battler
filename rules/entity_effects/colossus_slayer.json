{
  "name": "colossus_slayer",
  "source": "Colossus Slayer",
  "program": [
    {
      "block": "trigger",
      "event": "ATTACK_HIT",
      "holder": "caster",
      "target": "event.defender",
      "when": "event.attacker == entity and event.defender.hp < event.defender.max_hp",
      "then": [
        {
          "block": "damage",
          "damage_type": "event.action.primary_damage_type",
          "formula": "1d8"
        }
      ]
    }
  ]
}
