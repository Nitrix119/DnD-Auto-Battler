{
  "name": "stunned",
  "program": [
    {
      "block": "trigger",
      "event": "ATTACK_DECLARED",
      "holder": "defender",
      "when": "event.attacker == entity or event.defender == entity",
      "then": [
        { "block": "cancel", "condition": "event.attacker == entity" },
        { "block": "grant_advantage", "condition": "event.defender == entity" }
      ]
    }
  ],
  "_note": "TODO: Auto-fail STR and DEX saving throws (pending save system). SPELL_CAST cancellation (pending spell cast cancellation support)."
}
