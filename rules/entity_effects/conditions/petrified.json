{
  "name": "petrified",
  "program": [
    {
      "block": "trigger",
      "event": "ATTACK_DECLARED",
      "when": "event.attacker == entity or event.defender == entity",
      "then": [
        { "block": "cancel", "condition": "event.attacker == entity" },
        { "block": "grant_advantage", "condition": "event.defender == entity" }
      ]
    },
    {
      "block": "trigger",
      "event": "DAMAGE_INCOMING",
      "when": "event.defender == entity",
      "then": [
        { "block": "modify_damage", "multiplier": 0.5, "condition": "event.defender == entity" }
      ]
    }
  ],
  "_note": "TODO: Immune to poison and disease (pending condition immunity system). Auto-fail STR and DEX saving throws (pending save system). SPELL_CAST cancellation (pending spell cast cancellation support)."
}
