{
  "name": "damage_resistance_rule",
  "program": [
    {
      "block": "trigger",
      "event": "DAMAGE_INCOMING",
      "priority": 0,
      "when": "event.damage_list[0].damage_type in event.defender.stat_block.damage_resistances",
      "then": [
        { "block": "modify_damage", "multiplier": 0.5 }
      ]
    }
  ]
}
