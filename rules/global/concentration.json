{
  "name": "concentration_damage_check",
  "program": [
    {
      "block": "trigger",
      "event": "DAMAGE_DEALT",
      "priority": 0,
      "rebind_target": "event.defender",
      "when": "event.defender.has_concentration and event.total > 0",
      "then": [
        {
          "block": "force_concentration_check",
          "target": "current",
          "dc": "max(10, event.total // 2)"
        }
      ]
    }
  ]
}
