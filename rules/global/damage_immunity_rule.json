{
  "name": "damage_immunity_rule",
  "program": [
    {
      "block": "trigger",
      "event": "DAMAGE_INCOMING",
      "priority": 0,
      "when": "event.damage_list[0].damage_type in event.defender.stat_block.damage_immunities",
      "then": [
        { "block": "modify_damage", "multiplier": 0 }
      ]
    }
  ]
}
